# Copy this file as .env and fill in the values. Never commit the .env file to the repository.
PORT=8080
# The same database as the backend (its schema comes from DBPatSft).
DB_URL=jdbc:postgresql://localhost:5432/aquasense
DB_USER=aquasense
DB_PASSWORD=change-this-password
# The same JWT_SECRET as the backend: the AI service accepts the sessions the backend opens.
JWT_SECRET=
# The same INTERNAL_API_KEY as the backend (at least 16 characters): photo readings are recorded through it.
INTERNAL_API_KEY=
BACKEND_URL=http://localhost:8080
# Allowed origins for the frontend (comma separated)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# AI providers, tried in order (Gemini, then Groq). Free keys: aistudio.google.com and console.groq.com.
GEMINI_API_KEY=
GROQ_API_KEY=
